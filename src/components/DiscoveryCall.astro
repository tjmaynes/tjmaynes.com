---
import BookingLink from './BookingLink.astro';
interface Props { service?: string; }
const { service = 'home' } = Astro.props;
---
<section class="section wrap split" id="contact" aria-labelledby="contact-title">
  <div><h2 id="contact-title">Get in touch</h2></div>
  <div class="prose">
    <p>Tell me a little about what you’re working on. I offer a free 15-minute video call so we can meet and see whether I can help.</p>
    <div class="actions"><BookingLink service={service} placement="contact" /></div>
    <p class="small contact-email">You can also email me at <a href="mailto:tj@tjmaynes.com">tj@tjmaynes.com</a>.</p>
  </div>
</section>
