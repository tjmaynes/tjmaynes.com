---
import { sampleRows, buildReport, formatMoney } from '../lib/report.mjs';
const report = buildReport(sampleRows);
---
<div class="report-demo" data-report-demo>
  <div class="demo-heading"><span class="demo-label">Interactive example · Fictional data</span><span class="small">Weekly revenue report</span></div>
  <div class="demo-grid">
    <div>
      <h3>1. Check the figures</h3>
      <table><caption class="sr-only">Fictional revenue in US dollars for the current and previous periods</caption><thead><tr><th scope="col">Category</th><th scope="col">Previous</th><th scope="col">Current</th></tr></thead><tbody>{sampleRows.map(row => <tr><th scope="row">{row.category}</th><td>{formatMoney(row.previousCents)}</td><td data-category={row.category}>{formatMoney(row.currentCents)}</td></tr>)}</tbody></table>
      <div class="demo-controls" data-demo-controls hidden><label class="demo-switch"><input type="checkbox" data-missing />Try a missing figure</label><button class="button button-small" type="button" data-run>Check and prepare draft</button></div>
    </div>
    <div>
      <h3>2. Review the draft</h3>
      <div class="demo-result" role="status" aria-live="polite" aria-atomic="true"><p class="demo-status" data-status>Checks passed. Human review needed.</p><p data-draft>{report.ok && report.draft}</p></div>
      <p class="small demo-explanation">This example calculates totals and fills a template in your browser. It makes no live AI call and sends nothing. In a larger workflow, AI could draft a narrative from checked figures, with a person reviewing it before use.</p>
    </div>
  </div>
  <noscript><p class="small">JavaScript is off. The checked sample above still shows the input and draft. Enable JavaScript to try the missing-data case.</p></noscript>
</div>
<script>
  import { mountReportDemo } from '../scripts/report-demo.js';
  const root = document.querySelector('[data-report-demo]');
  if (root) mountReportDemo(root);
</script>
