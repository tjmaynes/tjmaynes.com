---
import SiteLayout from '../layouts/SiteLayout.astro';
import BookingLink from '../components/BookingLink.astro';
import DiscoveryCall from '../components/DiscoveryCall.astro';
import { coaching } from '../config/services.mjs';
---
<SiteLayout>
  <main id="main">
    <section class="hero wrap" aria-labelledby="hero-title">
      <h1 id="hero-title">Hi, I’m TJ.</h1>
      <p class="lead">I help businesses automate repetitive work and coach professionals who want to build their own AI automations.</p>
      <p class="intro-copy">I work with clients directly, from figuring out what to build to writing the code and explaining how it works.</p>
      <div class="actions"><BookingLink placement="hero" /><span class="call-note">Free 15-minute call</span></div>
    </section>

    <section class="section wrap" id="services" aria-labelledby="services-title">
      <div class="section-heading"><h2 id="services-title">Consulting and coaching</h2></div>
      <div class="two-column offers">
        <article>
          <h3><a href="/services/consulting/">Business automation consulting</a></h3>
          <p>I build workflows that connect the tools you already use, move data between them, and handle recurring tasks such as reporting. I can work with you or alongside your developers.</p>
          <p class="offer-terms">We’ll agree on the scope and a fixed price before I start.</p>
          <a class="text-link" href="/services/consulting/">More about consulting</a>
        </article>
        <article>
          <h3><a href="/services/coaching/">AI coaching</a></h3>
          <p>Bring a task from your work and we’ll build an automation together. You’ll have time to try things and ask questions along the way.</p>
          <p class="offer-terms">Sessions are ${coaching.price} {coaching.currency} for {coaching.minutes} minutes.</p>
          <a class="text-link" href="/services/coaching/">More about coaching</a>
        </article>
      </div>
    </section>

    <section class="section wrap split" id="about" aria-labelledby="about-title">
      <div><h2 id="about-title">About me</h2></div>
      <div class="prose">
        <p>I’m TJ Maynes. I’ve built software with teams at VMware Tanzu Labs and NBCUniversal, often pairing with others to work through technical problems.</p>
        <p>I like working through a real problem with the person who knows it best. I’ll ask questions, show you what I’m trying, and explain the decisions along the way.</p>
        <a class="text-link" href="https://linkedin.com/in/tjmaynes">My background on LinkedIn</a>
      </div>
    </section>
    <DiscoveryCall />
  </main>
</SiteLayout>
